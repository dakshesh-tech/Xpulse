# OPENROUTER_API_KEY: Required for OpenRouter Free AI Model Manager routing.
# Configure this in server-side environment / Settings > Secrets. Never commit real keys.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# FREE_ONLY_MODE: Enforces strictly zero-cost verified models server-side.
FREE_ONLY_MODE="true"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
